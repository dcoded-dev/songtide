    "What's playing in Songtide, with playback controls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يتم تشغيله في Songtide، مع عناصر التحكم في التشغيل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Què es reprodueix a Songtide, amb controls de reproducció."
