#!/bin/zsh
# Debug builds only: bring the running app's main window (or the window titled $1) to the front, active (for screenshots).
swift -e 'import Foundation; DistributedNotificationCenter.default().postNotificationName(.init("dev.dcoded.songtide.activate"), object: CommandLine.arguments.count > 1 ? CommandLine.arguments[1] : nil, deliverImmediately: true)' "$@"
