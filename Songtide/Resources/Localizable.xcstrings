    "Keep a record of what you listen to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بسجل لما تستمع إليه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteniu un registre del que escolteu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávejte si, co posloucháte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold et register over, hvad du lytter til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notieren Sie, was Sie hören."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε αρχείο με αυτά που ακούτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga un registro de lo que escucha."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga un registro de lo que escucha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kirjaa siitä, mitä kuuntelet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez une trace de ce que vous écoutez."
