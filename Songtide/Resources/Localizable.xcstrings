    "The song playing in Songtide, as \"Title — Artist\".": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأغنية التي يتم تشغيلها في Songtide، باسم \"العنوان — الفنان\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La cançó que es reprodueix a Songtide, com a \"Títol — Artista\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladba hrající v Songtide jako „Title — Artist“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangen afspilles i Songtide, som \"Titel — Kunstner\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lied, das in Songtide abgespielt wird, als „Titel — Künstler“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τραγούδι που παίζει στο Songtide, ως \"Title — Artist\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La canción que se reproduce en Songtide, como \"Título — Artista\"."
          }
        },
