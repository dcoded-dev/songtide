    "No menu bar icon; closing the window keeps Songtide in the Dock.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد رمز شريط القوائم؛ إغلاق النافذة يبقي Songtide في Dock."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense icona de la barra de menús; tancant la finestra es manté Songtide al Dock."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádná ikona panelu nabídek; zavřením okna zůstane Songtide v Dock."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet menulinjeikon; lukning af vinduet bevarer Songtide i Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Menüleistensymbol; Durch Schließen des Fensters bleibt Songtide im Dock."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει εικονίδιο γραμμής μενού. Το κλείσιμο του παραθύρου διατηρεί το Songtide στο Dock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin icono de barra de menú; cerrar la ventana mantiene el Songtide en el Dock."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin icono de barra de menú; cerrar la ventana mantiene el Songtide en el Dock."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei valikkorivin kuvaketta; ikkunan sulkeminen säilyttää Songtide:n Dock:ssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune icône dans la barre de menu ; la fermeture de la fenêtre maintient Songtide dans le Dock."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune icône dans la barre de menu ; la fermeture de la fenêtre maintient Songtide dans le Dock."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין סמל שורת תפריט; סגירת החלון שומרת על Songtide ב-Dock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई मेनू बार आइकन नहीं; विंडो बंद करने से Songtide Dock में रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema ikone trake izbornika; zatvaranje prozora zadržava Songtide u Dock."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs menüsor ikon; az ablak bezárásával a Songtide a Dock-ben marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada ikon bilah menu; menutup jendela membuat Songtide tetap berada di Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna icona nella barra dei menu; chiudendo la finestra si mantiene Songtide nello Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンはありません。ウィンドウを閉じると、Songtide は Dock に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 표시줄 아이콘이 없습니다. 창을 닫으면 Songtide가 Dock에 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada ikon bar menu; menutup tetingkap mengekalkan Songtide dalam Dock."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen menylinjeikon; ved å lukke vinduet beholdes Songtide i Dock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen menubalkpictogram; Als u het venster sluit, blijft Songtide in de Dock."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ikony na pasku menu; zamknięcie okna powoduje zachowanie Songtide w Dock."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ícone na barra de menu; fechar a janela mantém Songtide no Dock."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ícone na barra de menu; fechar a janela mantém Songtide no Dock."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără pictogramă din bara de meniu; închiderea ferestrei păstrează Songtide în Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет значка строки меню; закрытие окна сохраняет Songtide в Dock."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadna ikona panela s ponukami; zatvorením okna zostane Songtide v Dock."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen menyradsikon; genom att stänga fönstret behålls Songtide i Dock."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีไอคอนแถบเมนู การปิดหน้าต่างจะทำให้ Songtide อยู่ใน Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu simgesi yok; pencereyi kapatmak Songtide'yi Dock'de tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає значка рядка меню; закриття вікна залишає Songtide у Dock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có biểu tượng thanh menu; việc đóng cửa sổ sẽ giữ Songtide trong Dock."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無選單列圖示；關閉視窗會將 Songtide 保留在 Dock 中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无菜单栏图标；关闭窗口会将 Songtide 保留在 Dock 中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無選單列圖示；關閉視窗會將 Songtide 保留在 Dock 中。"
          }
        }
      }
