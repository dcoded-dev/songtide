    "Allow Songtide in Login Items to finish turning this on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Songtide في عناصر تسجيل الدخول بإنهاء تشغيل هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que Songtide en els elements d'inici de sessió acabi d'activar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte Songtide v položkách přihlášení dokončit zapínání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Songtide i login-elementer at afslutte med at slå dette til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Songtide in den Anmeldeelementen, die Aktivierung abzuschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε στα Songtide in Login Items να ολοκληρώσει την ενεργοποίησή του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Songtide en Elementos de inicio de sesión termine de activar esto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Songtide en Elementos de inicio de sesión termine de activar esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna Songtide:n kytkeä tämä päälle kirjautumiskohdissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Songtide dans les éléments de connexion à terminer l'activation."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Songtide dans les éléments de connexion à terminer l'activation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר ל-Songtide בפריטי התחברות לסיים את הפעלתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे चालू करने के लिए लॉगिन आइटम में Songtide को अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite Songtide u Stavkama za prijavu da dovrši ovo uključivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a Songtide bejelentkezési elemekben, hogy befejezze a bekapcsolását."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Songtide di Item Login untuk menyelesaikan pengaktifan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Songtide in Elementi di accesso di completare l'attivazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を有効にするには、ログイン項目でSongtideを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목의 Songtide를 허용하여 이 설정을 완료하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Songtide dalam Item Log Masuk untuk menyelesaikan menghidupkan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La Songtide i påloggingselementer fullføre å slå dette på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat Songtide in inlogitems dit inschakelen voltooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól Songtide w elementach logowania na dokończenie włączania tej opcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Songtide em Itens de login termine de ativar isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Songtide em Itens de início de sessão termine de ativar isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți Songtide în Elementele de conectare să termine activarea acestei opțiuni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Songtide в элементах входа в систему, чтобы завершить включение этого параметра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte Songtide v položkách prihlásenia dokončiť zapnutie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Songtide i inloggningsobjekt att slutföra att aktivera detta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ Songtide ในรายการเข้าสู่ระบบเปิดการดำเนินการนี้ให้เสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum Açma Öğelerindeki Songtide'nin bunu açmayı bitirmesine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Songtide у пунктах входу завершити ввімкнення цього."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Songtide trong Mục đăng nhập hoàn tất việc bật tính năng này."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「登入項目」中的 Songtide 完成此功能的開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“登录项”中的 Songtide 完成此功能的打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「登入項目」中的 Songtide 完成此功能的開啟。"
          }
        }
      }
    },
