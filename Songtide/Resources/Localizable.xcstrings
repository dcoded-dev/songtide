            "state": "translated",
            "value": "Vizualizator još ne može čuti glazbu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megjelenítő még nem hallja a zenét"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisator belum dapat mendengar musiknya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il visualizzatore non riesce ancora a sentire la musica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビジュアライザーはまだ音楽を聞くことができません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시각화 장치는 아직 음악을 들을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizer belum dapat mendengar muzik lagi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizeren kan ikke høre musikken ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De visualisator kan de muziek nog niet horen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizualizator nie słyszy jeszcze muzyki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O visualizador ainda não consegue ouvir a música"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O visualizador ainda não consegue ouvir a música"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizualizatorul nu poate auzi încă muzica"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Визуализатор пока не слышит музыку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizualizér ešte nepočuje hudbu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizern kan inte höra musiken ännu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizer ยังไม่ได้ยินเสียงเพลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleyici henüz müziği duyamıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Візуалізатор ще не чує музику"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình hiển thị chưa thể nghe được nhạc"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "視覺化工具還聽不到音樂"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可视化工具还听不到音乐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視覺化工具還聽不到音樂"
          }
        }
      }
    },
    "Titles and artists too long for the player bar scroll to show the rest. Off: they're cut short.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين والفنانين طويلة جدًا بحيث لا يمكن تمرير شريط المشغل لإظهار الباقي. قبالة: لقد قطعوا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els títols i els artistes són massa llargs perquè la barra del jugador es desplaça per mostrar la resta. Off: s'han escurçat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy a interpreti jsou příliš dlouhé na to, aby se na liště přehrávače zobrazil zbytek. Vypnuto: jsou zkrácené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler og kunstnere er for lange til, at afspillerbjælken kan rulle for at vise resten. Off: de er afskåret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel und Interpreten sind zu lang, als dass der Rest in der Playerleiste angezeigt werden könnte. Aus: Sie sind abgebrochen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τίτλοι και οι καλλιτέχνες είναι πολύ μεγάλοι για να εμφανιστούν τα υπόλοιπα με κύλιση στη γραμμή αναπαραγωγής. Off: κόβονται απότομα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos y artistas demasiado largos para que la barra del reproductor se desplace para mostrar el resto. Apagado: se cortan en seco."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos y artistas demasiado largos para que la barra del reproductor se desplace para mostrar el resto. Apagado: se cortan en seco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimikkeet ja artistit ovat liian pitkiä, jotta soitinpalkin vierittäminen näyttää loput. Pois päältä: ne on lyhennetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres et artistes trop longs pour que la barre du lecteur défile pour afficher le reste. Off : ils sont coupés court."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres et artistes trop longs pour que la barre du lecteur défile pour afficher le reste. Off : ils sont coupés court."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרות ואמנים ארוכים מדי מכדי שסרגל הנגן יראה את השאר. כבוי: הם נקטעו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक और कलाकार बाकी दिखाने के लिए प्लेयर बार स्क्रॉल के लिए बहुत लंबे हैं। बंद: वे छोटे हो गए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi i izvođači su predugački da bi pomicanje trake playera moglo prikazati ostatak. Isključeno: kratko su ošišani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címek és az előadók túl hosszúak ahhoz, hogy a lejátszósáv görgesse a többit. Off: rövidre vágják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul dan artis terlalu panjang sehingga bilah pemutar dapat digulir untuk menampilkan sisanya. Mati: mereka dipotong pendek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli e artisti troppo lunghi perché lo scorrimento della barra del lettore possa mostrare il resto. Off: sono interrotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲名やアーティスト名がプレーヤーバーに収まらない場合は、スクロールして全体を表示します。オフの場合は省略されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어 바 스크롤에 나머지 내용을 표시하기에는 제목과 아티스트가 너무 깁니다. 끄기: 짧게 잘렸습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk dan artis terlalu panjang untuk tatal bar pemain untuk menunjukkan yang lain. Mati: mereka dipotong pendek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler og artister er for lange til at spillerlinjen ruller for å vise resten. Av: de er avkortet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Titels en artiesten zijn te lang om door de spelersbalk te scrollen om de rest weer te geven. Uit: ze zijn kortgeknipt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły i wykonawcy są zbyt długie, aby pasek odtwarzacza mógł wyświetlić resztę. Wyłączone: są obcięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos e artistas muito longos para a rolagem da barra do player mostrar o resto. Desligado: eles são interrompidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos e artistas demasiado longos para a rolagem da barra do leitor mostrar o resto. Desligado: são interrompidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlurile și artiștii sunt prea lungi pentru a derula bara jucătorului pentru a afișa restul. Off: sunt scurtate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия и исполнители слишком длинные, чтобы прокрутить панель проигрывателя и отобразить остальное. Выкл.: они обрезаны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy a interpreti sú príliš dlhé na to, aby sa na lište prehrávača zobrazil zvyšok. Vypnuté: sú skrátené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar och artister är för långa för att spelarfältet ska rulla för att visa resten. Av: de är kortade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อและศิลปินยาวเกินไปสำหรับการเลื่อนแถบผู้เล่นเพื่อแสดงส่วนที่เหลือ ปิด: พวกมันถูกตัดให้สั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklar ve sanatçılar, oynatıcı çubuğu kaydırarak geri kalanını gösteremeyecek kadar uzun. Kapalı: kısa kesilirler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви та виконавці задовгі, щоб прокручувати панель програвача, щоб показати решту. Вимкнено: вони коротко підстрижені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề và nghệ sĩ quá dài nên thanh cuộn trình phát không thể hiển thị phần còn lại. Tắt: chúng bị cắt ngắn."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "標題和藝術家太長，播放器滾動列無法顯示其餘內容。關閉：它們被縮短。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题和艺术家太长，播放器滚动栏无法显示其余内容。关闭：它们被缩短。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題和藝術家太長，播放器滾動列無法顯示其餘內容。關閉：它們被縮短。"
          }
        }
      }
    },
    "Tracks start as audio whenever there's a song version, even music videos. Switch any track to Video on the player page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ المسارات كصوت عندما يكون هناك إصدار أغنية، حتى مقاطع الفيديو الموسيقية. قم بتحويل أي مسار إلى فيديو على صفحة المشغل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pistes comencen com a àudio sempre que hi hagi una versió de cançó, fins i tot vídeos musicals. Canvia qualsevol pista a Vídeo a la pàgina del reproductor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby začínají jako zvuk, kdykoli je k dispozici verze skladby, dokonce i hudební videa. Přepněte libovolnou stopu na Video na stránce přehrávače."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Numre starter som lyd, når der er en sangversion, selv musikvideoer. Skift ethvert spor til Video på afspillersiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel beginnen immer dann als Audio, wenn es eine Songversion gibt, auch Musikvideos. Schalten Sie auf der Player-Seite einen beliebigen Titel auf „Video“ um."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κομμάτια ξεκινούν ως ήχος όποτε υπάρχει μια έκδοση τραγουδιού, ακόμα και μουσικά βίντεο. Αλλάξτε οποιοδήποτε κομμάτι σε Βίντεο στη σελίδα του προγράμματος αναπαραγωγής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pistas comienzan como audio siempre que hay una versión de la canción, incluso videos musicales. Cambie cualquier pista a Video en la página del reproductor."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pistas comienzan como audio siempre que hay una versión de la canción, incluso videos musicales. Cambie cualquier pista a Video en la página del reproductor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleet alkavat äänenä aina, kun niistä on kappaleversio, jopa musiikkivideot. Vaihda minkä tahansa kappaleen videoksi soitinsivulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pistes commencent sous forme audio chaque fois qu'il existe une version de chanson, même des clips vidéo. Basculez n’importe quelle piste en vidéo sur la page du lecteur."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pistes commencent sous forme audio chaque fois qu'il existe une version de chanson, même des clips vidéo. Basculez n’importe quelle piste en vidéo sur la page du lecteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רצועות מתחילות כשמע בכל פעם שיש גרסת שיר, אפילו קליפים. העבר כל רצועה לסרטון בדף הנגן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी कोई गीत संस्करण होता है, तो ट्रैक ऑडियो के रूप में शुरू होते हैं, यहां तक ​​कि संगीत वीडियो भी। प्लेयर पेज पर किसी भी ट्रैक को वीडियो पर स्विच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesme počinju kao audio kad god postoji verzija pjesme, čak i glazbeni spotovi. Prebacite bilo koji zapis na Video na stranici playera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számok hangként indulnak, ha van dal verziója, még zenei videók is. Váltson át bármelyik számot Videóra a lejátszó oldalon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek dimulai sebagai audio setiap kali ada versi lagu, bahkan video musik. Alihkan trek apa pun ke Video di halaman pemutar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tracce iniziano come audio ogni volta che è disponibile una versione del brano, anche video musicali. Passa qualsiasi traccia a Video nella pagina del lettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージック ビデオであっても、曲のバージョンがある場合は常に、トラックはオーディオとして開始されます。プレーヤー ページで任意のトラックをビデオに切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래 버전이 있을 때마다 트랙이 오디오로 시작됩니다. 뮤직 비디오도 마찬가지입니다. 플레이어 페이지에서 트랙을 비디오로 전환하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu bermula sebagai audio apabila terdapat versi lagu, malah video muzik. Tukar mana-mana trek kepada Video pada halaman pemain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor starter som lyd når det er en sangversjon, til og med musikkvideoer. Bytt et spor til video på spillersiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks beginnen als audio wanneer er een nummerversie is, zelfs muziekvideo's. Schakel een nummer over naar Video op de spelerpagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory zaczynają się jako dźwięk, jeśli dostępna jest wersja utworu, nawet teledyski. Przełącz dowolną ścieżkę na Wideo na stronie odtwarzacza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As faixas começam como áudio sempre que há uma versão de música, até mesmo videoclipes. Mude qualquer faixa para Vídeo na página do player."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As faixas começam como áudio sempre que há uma versão de música, até mesmo os videoclipes. Mude qualquer faixa para Vídeo na página do leitor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesele încep ca audio ori de câte ori există o versiune de cântec, chiar și videoclipuri muzicale. Comutați orice piesă la Video pe pagina playerului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Треки начинаются как аудио, если есть версия песни, даже музыкальные клипы. Переключите любой трек в режим «Видео» на странице плеера."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby začínajú ako zvuk vždy, keď je k dispozícii verzia skladby, dokonca aj hudobné videá. Prepnite ľubovoľnú skladbu na Video na stránke prehrávača."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spår börjar som ljud när det finns en låtversion, till och med musikvideor. Byt valfritt spår till Video på spelarsidan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทร็กจะเริ่มเป็นเสียงทุกครั้งที่มีเวอร์ชันเพลง แม้แต่มิวสิควิดีโอ สลับแทร็กเป็นวิดีโอในหน้าเครื่องเล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parçalar, bir şarkı versiyonu, hatta müzik videoları olduğunda ses olarak başlar. Oynatıcı sayfasında herhangi bir parçayı Video olarak değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Композиції починаються як аудіо, коли є версія пісні, навіть музичні відео. Перемкніть будь-який трек на відео на сторінці плеєра."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản nhạc bắt đầu dưới dạng âm thanh bất cứ khi nào có phiên bản bài hát, thậm chí cả video nhạc. Chuyển bất kỳ bản nhạc nào sang Video trên trang trình phát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每當有歌曲版本（甚至是音樂錄影帶）時，曲目都會以音訊形式開始。在播放器頁面將任意曲目切換為影片。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每当有歌曲版本（甚至是音乐视频）时，曲目都会以音频形式开始。在播放器页面将任意曲目切换为视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每當有歌曲版本（甚至是音樂錄影帶）時，曲目都會以音訊形式開始。在播放器頁面將任意曲目切換為影片。"
          }
        }
      }
    },
