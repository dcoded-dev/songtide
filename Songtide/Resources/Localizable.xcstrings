    "General, playback and sidebar settings go back to their defaults, and Open at Login turns off. You'll stay signed in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود الإعدادات العامة والتشغيل والشريط الجانبي إلى إعداداتها الافتراضية، ويتم إيقاف تشغيل فتح عند تسجيل الدخول. ستظل مسجلاً الدخول."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els paràmetres generals, de reproducció i de la barra lateral tornen als valors predeterminats, i Obre a l'inici de sessió es desactiva. Continuaràs la sessió iniciada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecná nastavení, přehrávání a nastavení postranního panelu se vrátí na výchozí hodnoty a možnost Otevřít při přihlášení se vypne. Zůstanete přihlášeni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Generelt, indstillinger for afspilning og sidebjælke går tilbage til deres standardindstillinger, og Åbn ved login deaktiveres. Du forbliver logget ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen „Allgemein“, „Wiedergabe“ und „Seitenleiste“ werden auf ihre Standardeinstellungen zurückgesetzt und „Bei Anmeldung öffnen“ wird deaktiviert. Sie bleiben angemeldet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρυθμίσεις Γενικά, αναπαραγωγής και πλαϊνής γραμμής επιστρέφουν στις προεπιλογές τους και το Open at Login απενεργοποιείται. Θα παραμείνετε συνδεδεμένοι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las configuraciones generales, de reproducción y de la barra lateral vuelven a sus valores predeterminados y Abrir al iniciar sesión se desactiva. Permanecerás conectado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las configuraciones generales, de reproducción y de la barra lateral vuelven a sus valores predeterminados y Abrir al iniciar sesión se desactiva. Permanecerás conectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yleiset, toisto- ja sivupalkin asetukset palaavat oletusarvoihinsa, ja Avaa sisäänkirjautumisen yhteydessä sammuu. Pysyt kirjautuneena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres généraux, de lecture et de la barre latérale reviennent à leurs valeurs par défaut et Ouvrir à la connexion est désactivé. Vous resterez connecté."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres généraux, de lecture et de la barre latérale reviennent à leurs valeurs par défaut et Ouvrir à la connexion est désactivé. Vous resterez connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות כלליות, השמעה וסרגל הצד חוזרות לברירות המחדל שלהן, ופתיחה בכניסה נכבית. אתה תישאר מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य, प्लेबैक और साइडबार सेटिंग्स अपने डिफ़ॉल्ट पर वापस चली जाती हैं, और लॉगिन पर खोलें बंद हो जाता है। आप साइन इन रहेंगे."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Općenito, postavke reprodukcije i bočne trake vraćaju se na zadane vrijednosti, a Otvori pri prijavi se isključuje. Ostat ćete prijavljeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az általános, a lejátszási és az oldalsáv beállításai visszaállnak az alapértelmezett értékekre, a Megnyitás bejelentkezéskor funkció pedig kikapcsol. Ön bejelentkezve marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan umum, pemutaran dan sidebar kembali ke defaultnya, dan Buka saat Login dimatikan. Anda akan tetap masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni generali, di riproduzione e della barra laterale tornano ai valori predefiniti e Apri all'accesso viene disattivato. Rimarrai connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般、再生、サイドバーの設定がデフォルトに戻り、「ログイン時に開く」がオフになります。サインインしたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반, 재생 및 사이드바 설정이 기본값으로 돌아가고 로그인 시 열기가 꺼집니다. 로그인 상태가 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan umum, main balik dan bar sisi kembali kepada lalainya dan Buka di Log Masuk dimatikan. Anda akan kekal log masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Generelle, avspillings- og sidefeltinnstillinger går tilbake til standardinnstillingene, og Åpne ved pålogging slås av. Du forblir pålogget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De algemene, afspeel- en zijbalkinstellingen gaan terug naar hun standaardwaarden en Openen bij inloggen wordt uitgeschakeld. Je blijft ingelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia ogólne, odtwarzania i paska bocznego wracają do wartości domyślnych, a opcja Otwórz przy logowaniu zostaje wyłączona. Pozostaniesz zalogowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações gerais, de reprodução e da barra lateral voltam aos padrões e Abrir no login é desativado. Você permanecerá conectado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições gerais, de reprodução e da barra lateral voltam aos padrões e Abrir no início de sessão é desativado. Permanecerá conectado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările generale, de redare și bara laterală revin la valorile implicite, iar Deschiderea la conectare se dezactivează. Veți rămâne conectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общие настройки, параметры воспроизведения и боковой панели возвращаются к значениям по умолчанию, а параметр «Открывать при входе в систему» отключается. Вы останетесь в системе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všeobecné nastavenia, prehrávanie a nastavenia bočného panela sa vrátia na predvolené hodnoty a možnosť Otvoriť pri prihlásení sa vypne. Zostanete prihlásený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allmänt, uppspelnings- och sidofältsinställningarna går tillbaka till sina standardinställningar och Öppna vid inloggning stängs av. Du förblir inloggad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าทั่วไป การเล่นและแถบด้านข้างจะกลับไปเป็นค่าเริ่มต้น และปิดเปิดเมื่อเข้าสู่ระบบ คุณจะยังคงลงชื่อเข้าใช้อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel, oynatma ve kenar çubuğu ayarları varsayılan değerlerine döner ve Oturum Açıldığında Aç kapatılır. Oturumunuz açık kalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Загальні параметри відтворення та бічної панелі повертаються до значень за замовчуванням, а «Відкрити під час входу» вимикається. Ви залишатиметеся в системі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt chung, phát lại và thanh bên sẽ trở về mặc định và Mở khi đăng nhập sẽ tắt. Bạn sẽ vẫn đăng nhập."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "常規、播放和側邊欄設定將恢復為預設值，並且「登入時開啟」將關閉。您將保持登入狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常规、播放和侧边栏设置将恢复为默认值，并且“登录时打开”将关闭。您将保持登录状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常規、播放和側邊欄設定將恢復為預設值，並且「登入時開啟」將關閉。您將保持登入狀態。"
          }
        }
      }
    },
