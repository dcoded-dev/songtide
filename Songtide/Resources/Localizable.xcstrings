    "Closing the window hides the Dock icon; Songtide keeps running in the menu bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي إغلاق النافذة إلى إخفاء رمز Dock؛ يستمر تشغيل Songtide في شريط القائمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En tancar la finestra s'amaga la icona Dock; Songtide continua funcionant a la barra de menús."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavřením okna skryjete ikonu Dock; Songtide stále běží na liště nabídek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukning af vinduet skjuler Dock-ikonet; Songtide bliver ved med at køre i menulinjen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schließen des Fensters wird das Dock-Symbol ausgeblendet. Songtide läuft weiterhin in der Menüleiste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλείσιμο του παραθύρου αποκρύπτει το εικονίδιο Dock. Το Songtide συνεχίζει να εκτελείται στη γραμμή μενού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar la ventana se oculta el icono Dock; Songtide sigue ejecutándose en la barra de menú."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar la ventana se oculta el icono Dock; Songtide sigue ejecutándose en la barra de menú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikkunan sulkeminen piilottaa Dock-kuvakkeen. Songtide jatkaa toimintaansa valikkorivillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture de la fenêtre masque l'icône Dock ; Songtide continue de s'exécuter dans la barre de menus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture de la fenêtre masque l'icône Dock ; Songtide continue de s'exécuter dans la barre de menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגירת החלון מסתירה את הסמל Dock; Songtide ממשיך לפעול בשורת התפריטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो बंद करने से Dock आइकन छिप जाता है; Songtide मेनू बार में चलता रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranjem prozora skriva se ikona Dock; Songtide nastavlja raditi na traci izbornika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ablak bezárása elrejti a Dock ikont; A Songtide folyamatosan fut a menüsorban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutup jendela akan menyembunyikan ikon Dock; Songtide terus berjalan di bilah menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo la finestra si nasconde l'icona Dock; Songtide continua a funzionare nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウを閉じると、Dock アイコンが非表示になります。 Songtide はメニュー バーで実行され続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창을 닫으면 Dock 아이콘이 숨겨집니다. Songtide는 메뉴 표시줄에서 계속 실행됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutup tetingkap menyembunyikan ikon Dock; Songtide terus berjalan dalam bar menu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lukke vinduet skjuler Dock-ikonet; Songtide fortsetter å kjøre i menylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u het venster sluit, wordt het Dock-pictogram verborgen; Songtide blijft actief in de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie okna powoduje ukrycie ikony Dock; Songtide działa na pasku menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar a janela oculta o ícone Dock; Songtide continua em execução na barra de menu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar a janela oculta o ícone Dock; Songtide continua a ser executado na barra de menus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închiderea ferestrei ascunde pictograma Dock; Songtide continuă să ruleze în bara de meniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие окна скрывает значок Dock; Songtide продолжает работать в строке меню."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvorením okna sa skryje ikona Dock; Songtide stále beží na paneli s ponukami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du stänger fönstret döljs Dock-ikonen; Songtide fortsätter att köras i menyraden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดหน้าต่างจะซ่อนไอคอน Dock Songtide ยังคงทำงานในแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerenin kapatılması Dock simgesini gizler; Songtide menü çubuğunda çalışmaya devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття вікна приховає піктограму Dock; Songtide продовжує працювати на панелі меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng cửa sổ sẽ ẩn biểu tượng Dock; Songtide tiếp tục chạy trên thanh menu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗隱藏Dock圖示； Songtide在選單列中持續運作。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口隐藏Dock图标； Songtide在菜单栏中持续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗隱藏Dock圖示； Songtide在選單列中持續運作。"
          }
        }
      }
    },
