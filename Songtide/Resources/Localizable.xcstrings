    "Always in the Dock, with the mini player in the menu bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دائمًا في Dock، مع المشغل الصغير في شريط القائمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre al Dock, amb el mini reproductor a la barra de menús."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy v Dock, s mini přehrávačem v liště nabídek."
          }
        },
        "da": {
