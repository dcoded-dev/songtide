    "Your Discord status shows the song, artist and artwork while music plays. Needs the Discord app open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض حالة Discord الأغنية والفنان والعمل الفني أثناء تشغيل الموسيقى. يحتاج إلى فتح تطبيق Discord."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El vostre estat Discord mostra la cançó, l'artista i les obres d'art mentre sona la música. Necessita l'aplicació Discord oberta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš stav Discord zobrazuje skladbu, umělce a umělecká díla při přehrávání hudby. Vyžaduje otevřenou aplikaci Discord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Discord-status viser sangen, kunstneren og kunstværket, mens musikken afspilles. Kræver Discord-appen åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Discord-Status zeigt den Song, den Interpreten und das Artwork an, während Musik abgespielt wird. Muss die Discord-App geöffnet haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάστασή σας Discord εμφανίζει το τραγούδι, τον καλλιτέχνη και το έργο τέχνης κατά την αναπαραγωγή μουσικής. Χρειάζεται ανοιχτή η εφαρμογή Discord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su estado Discord muestra la canción, el artista y la obra de arte mientras se reproduce música. Necesita tener abierta la aplicación Discord."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Su estado Discord muestra la canción, el artista y la obra de arte mientras se reproduce música. Necesita tener abierta la aplicación Discord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord-tila näyttää kappaleen, artistin ja taideteoksen musiikin soidessa. Tarvitsee Discord-sovelluksen auki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre statut Discord affiche la chanson, l'artiste et l'illustration pendant la lecture de la musique. Nécessite que l'application Discord soit ouverte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre statut Discord affiche la chanson, l'artiste et l'illustration pendant la lecture de la musique. Nécessite que l'application Discord soit ouverte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב ה-Discord שלך מציג את השיר, האמן והגרפיקה בזמן שהמוזיקה מתנגנת. צריך שהאפליקציה Discord פתוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगीत बजने के दौरान आपका Discord स्टेटस गीत, कलाकार और कलाकृति दिखाता है। Discord ऐप खोलने की आवश्यकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš Discord status prikazuje pjesmu, izvođača i umjetničko djelo dok se glazba reproducira. Treba otvoriti aplikaciju Discord."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Discord állapota zene lejátszása közben mutatja a dalt, az előadót és a műalkotást. Meg kell nyitnia a Discord alkalmazást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Discord Anda menampilkan lagu, artis, dan karya seni saat musik diputar. Perlu membuka aplikasi Discord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato Discord mostra il brano, l'artista e la grafica durante la riproduzione della musica. È necessario che l'app Discord sia aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord ステータスには、音楽の再生中に曲、アーティスト、アートワークが表示されます。 Discord アプリを開く必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord 상태에는 음악이 재생되는 동안 노래, 아티스트, 작품이 표시됩니다. Discord 앱이 열려 있어야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Discord anda menunjukkan lagu, artis dan karya seni semasa muzik dimainkan. Perlukan apl Discord dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Discord-status viser sangen, artisten og kunstverket mens musikken spilles. Trenger Discord-appen åpen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw Discord-status toont het nummer, de artiest en het artwork terwijl de muziek wordt afgespeeld. Hiervoor moet de Discord-app geopend zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój status Discord pokazuje utwór, wykonawcę i grafikę podczas odtwarzania muzyki. Wymaga otwartej aplikacji Discord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O status do seu Discord mostra a música, o artista e a arte enquanto a música é reproduzida. Precisa do aplicativo Discord aberto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado do seu Discord mostra a música, o artista e a arte enquanto a música é reproduzida. Necessita do aplicativo Discord aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Starea dvs. Discord arată melodia, artistul și opera de artă în timpul redării muzicii. Necesita deschiderea aplicației Discord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время воспроизведения музыки в вашем статусе Discord отображается песня, исполнитель и обложка. Требуется открытое приложение Discord."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš stav Discord zobrazuje skladbu, interpreta a umelecké dielo počas prehrávania hudby. Vyžaduje otvorenie aplikácie Discord."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Discord-status visar låten, artisten och konstverket medan musik spelas. Behöver Discord-appen öppen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะ Discord ของคุณจะแสดงเพลง ศิลปิน และอาร์ตเวิร์กขณะเล่นเพลง ต้องการเปิดแอป Discord"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord durumunuz, müzik çalarken şarkıyı, sanatçıyı ve sanat eserini gösterir. Discord uygulamasının açık olması gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш статус Discord показує пісню, виконавця та обкладинку під час відтворення музики. Потрібно відкрити програму Discord."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái Discord của bạn hiển thị bài hát, nghệ sĩ và tác phẩm nghệ thuật trong khi nhạc phát. Cần mở ứng dụng Discord."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當音樂播放時，您的 Discord 狀態會顯示歌曲、藝術家和藝術作品。需要開啟 Discord 應用程式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当音乐播放时，您的 Discord 状态会显示歌曲、艺术家和艺术作品。需要打开 Discord 应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當音樂播放時，您的 Discord 狀態會顯示歌曲、藝術家和藝術作品。需要開啟 Discord 應用程式。"
          }
        }
      }
    },
