    "Installs the update and reopens Songtide. Otherwise it installs the next time you quit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بتثبيت التحديث وإعادة فتح Songtide. وإلا فإنه يتم تثبيته في المرة التالية التي تقوم فيها بالانسحاب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·la l'actualització i torna a obrir Songtide. En cas contrari, s'instal·larà la propera vegada que sortiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainstaluje aktualizaci a znovu otevře Songtide. Jinak se nainstaluje při příštím ukončení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerer opdateringen og genåbner Songtide. Ellers installeres den næste gang du afslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert das Update und öffnet Songtide erneut. Andernfalls wird es beim nächsten Beenden installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαθιστά την ενημέρωση και ανοίγει ξανά το Songtide. Διαφορετικά, εγκαθίσταται την επόμενη φορά που θα σταματήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la actualización y vuelve a abrir Songtide. De lo contrario, se instalará la próxima vez que salga."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la actualización y vuelve a abrir Songtide. De lo contrario, se instalará la próxima vez que salga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asentaa päivityksen ja avaa Songtide uudelleen. Muuten se asentuu seuraavan kerran, kun lopetat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe la mise à jour et rouvre Songtide. Sinon, il s'installera la prochaine fois que vous quitterez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe la mise à jour et rouvre Songtide. Sinon, il s'installera la prochaine fois que vous quitterez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתקין את העדכון ופותח מחדש את Songtide. אחרת הוא מותקן בפעם הבאה שתפסיק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्यतन स्थापित करता है और Songtide को फिर से खोलता है। अन्यथा अगली बार जब आप इसे छोड़ेंगे तो यह इंस्टॉल हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalira ažuriranje i ponovno otvara Songtide. Inače će se instalirati sljedeći put kada izađete iz programa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepíti a frissítést, és újra megnyitja a Songtide fájlt. Ellenkező esetben a következő kilépéskor települ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginstal pembaruan dan membuka kembali Songtide. Kalau tidak, itu akan diinstal pada saat Anda keluar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa l'aggiornamento e riapre Songtide. Altrimenti si installerà la prossima volta che esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートをインストールし、Songtide を再度開きます。それ以外の場合は、次回終了時にインストールされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 설치하고 Songtide를 다시 엽니다. 그렇지 않으면 다음에 종료할 때 설치됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memasang kemas kini dan membuka semula Songtide. Jika tidak, ia dipasang pada kali seterusnya anda berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerer oppdateringen og åpner Songtide på nytt. Ellers installeres den neste gang du avslutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeert de update en opent Songtide opnieuw. Anders wordt het geïnstalleerd de volgende keer dat u afsluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluje aktualizację i ponownie otwiera Songtide. W przeciwnym razie zostanie on zainstalowany przy następnym wyjściu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala a atualização e reabre Songtide. Caso contrário, ele será instalado na próxima vez que você sair."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala a atualização e reabre Songtide. Caso contrário, será instalado na próxima vez que sair."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalează actualizarea și redeschide Songtide. În caz contrar, se instalează data viitoare când renunți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает обновление и повторно открывает Songtide. В противном случае он будет установлен при следующем выходе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainštaluje aktualizáciu a znova otvorí Songtide. V opačnom prípade sa nainštaluje pri ďalšom ukončení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerar uppdateringen och öppnar Songtide igen. Annars installeras den nästa gång du avslutar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งการอัปเดตและเปิด Songtide อีกครั้ง มิฉะนั้นจะติดตั้งในครั้งถัดไปที่คุณออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleştirmeyi yükler ve Songtide'yi yeniden açar. Aksi halde bir sonraki çıkışınızda yüklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює оновлення та повторно відкриває Songtide. Інакше він інсталюється наступного разу, коли ви вийдете."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt bản cập nhật và mở lại Songtide. Nếu không nó sẽ cài đặt vào lần tiếp theo bạn thoát."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝更新並重新開啟 Songtide。否則，它將在您下次退出時安裝。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装更新并重新打开 Songtide。否则，它将在您下次退出时安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝更新並重新開啟 Songtide。否則，它將在您下次退出時安裝。"
          }
        }
      }
    },
