    "A notification with the song and artwork, only while Songtide isn't in front.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعار بالأغنية والعمل الفني، فقط عندما لا يكون Songtide في المقدمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificació amb la cançó i l'il·lustració, només quan Songtide no estigui al davant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení se skladbou a grafikou, pouze když není Songtide vpředu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En notifikation med sangen og kunstværket, kun mens Songtide ikke er foran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Benachrichtigung mit dem Song und dem Artwork, nur solange Songtide nicht vorne ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ειδοποίηση με το τραγούδι και το έργο τέχνης, μόνο όταν το Songtide δεν είναι μπροστά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación con la canción y el arte, solo mientras Songtide no esté al frente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación con la canción y el arte, solo mientras Songtide no esté al frente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitus kappaleen ja kuvituksen kera, vain kun Songtide ei ole edessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification avec la chanson et l'illustration, uniquement lorsque Songtide n'est pas devant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification avec la chanson et l'illustration, uniquement lorsque Songtide n'est pas devant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודעה עם השיר והגרפיקה, רק כאשר Songtide לא מלפנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गीत और कलाकृति के साथ एक अधिसूचना, केवल जबकि Songtide सामने नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijest s pjesmom i umjetničkim djelom, samo dok Songtide nije ispred."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítés a dallal és a műalkotással, csak amíg a Songtide nincs előtte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi berisi lagu dan artwork, hanya saja saat Songtide tidak ada di depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica con la canzone e l'artwork, solo mentre Songtide non è davanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Songtide が前にいないときにのみ、曲とアートワーク付きの通知が送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Songtide가 앞에 없을 때만 노래와 아트워크가 포함된 알림입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dengan lagu dan karya seni, hanya semasa Songtide tiada di hadapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et varsel med sangen og kunstverket, bare mens Songtide ikke er foran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding met het nummer en artwork, alleen als Songtide niet voorop staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie z piosenką i grafiką tylko wtedy, gdy Songtide nie znajduje się z przodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação com a música e a arte, apenas enquanto Songtide não estiver na frente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação com a música e a arte, apenas enquanto Songtide não estiver na frente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O notificare cu melodia și opera de artă, doar în timp ce Songtide nu este în față."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление с песней и обложкой, только пока Songtide не впереди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornenie so skladbou a predlohou, iba ak Songtide nie je vpredu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En avisering med låten och konstverket, bara när Songtide inte är framme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนด้วยเพลงและอาร์ตเวิร์คเฉพาะขณะที่ Songtide ไม่อยู่ข้างหน้าเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkıyı ve çizimi içeren bir bildirim, yalnızca Songtide önde değilken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення з піснею та обкладинкою, лише якщо попереду немає Songtide."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo kèm theo bài hát và tác phẩm nghệ thuật, chỉ khi Songtide không ở phía trước."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有當 Songtide 不在前面時才會顯示包含歌曲和藝術作品的通知。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当 Songtide 不在前面时才会显示包含歌曲和艺术作品的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有當 Songtide 不在前面時才會顯示包含歌曲和藝術作品的通知。"
          }
        }
      }
    },
