    "Songs count once you've heard half (or four minutes), as Last.fm asks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم احتساب الأغاني بمجرد سماعك للنصف (أو أربع دقائق)، كما يطلب Last.fm."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cançons compten un cop escolteu la meitat (o quatre minuts), tal com us demana Last.fm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby se počítají, jakmile uslyšíte polovinu (nebo čtyři minuty), jak se ptá Last.fm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sange tæller, når du har hørt halvdelen (eller fire minutter), som Last.fm spørger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs zählen, sobald Sie die Hälfte (oder vier Minuten) gehört haben, wie Last.fm verlangt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τραγούδια μετράνε μόλις ακούσετε μισό (ή τέσσερα λεπτά), όπως σας ζητάει ο Last.fm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones cuentan una vez que hayas escuchado la mitad (o cuatro minutos), como pregunta Last.fm."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones cuentan una vez que hayas escuchado la mitad (o cuatro minutos), como pregunta Last.fm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kappaleet lasketaan, kun olet kuullut puolet (tai neljä minuuttia), kuten Last.fm kysyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chansons comptent une fois que vous en avez entendu la moitié (ou quatre minutes), comme le demande Last.fm."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chansons comptent une fois que vous en avez entendu la moitié (ou quatre minutes), comme le demande Last.fm."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירים נחשבים ברגע ששמעת חצי (או ארבע דקות), כפי ש-Last.fm שואל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसा कि Last.fm पूछता है, गाने आधे (या चार मिनट) सुनने के बाद मायने रखते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pjesme se računaju nakon što ste čuli pola (ili četiri minute), kao što Last.fm traži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dalok akkor számítanak, ha a felét (vagy négy percet) meghallotta, ahogy a Last.fm kéri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu dihitung setelah Anda mendengarkan setengahnya (atau empat menit), seperti yang diminta Last.fm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le canzoni contano una volta ascoltate metà (o quattro minuti), come chiede Last.fm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm が求めるように、曲は半分 (または 4 分) 聞いたらカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm가 요구하는 것처럼 노래는 절반(또는 4분)만 들으면 계산됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagu dikira sebaik sahaja anda mendengar separuh (atau empat minit), seperti yang ditanya oleh Last.fm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanger teller når du har hørt halvparten (eller fire minutter), som Last.fm spør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers tellen zodra je de helft (of vier minuten) hebt gehoord, zoals Last.fm vraagt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwory liczą się po przesłuchaniu połowy (lub czterech minut), jak pyta Last.fm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas contam quando você ouve metade (ou quatro minutos), como pede Last.fm."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas contam quando ouve metade (ou quatro minutos), como pede Last.fm."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cântecele contează odată ce ați auzit jumătate (sau patru minute), așa cum vă întreabă Last.fm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Песня засчитывается после того, как вы прослушали половину (или четыре минуты), как спрашивает Last.fm."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skladby sa počítajú, keď budete počuť polovicu (alebo štyri minúty), ako sa pýta Last.fm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låtar räknas när du har hört hälften (eller fyra minuter), som Last.fm frågar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพลงจะนับเมื่อคุณได้ยินครึ่ง (หรือสี่นาที) ตามที่ Last.fm ถาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Last.fm'nin sorduğu gibi şarkıların yarısını (veya dört dakikayı) dinlediğinizde sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пісні зараховуються, коли ви прослухали половину (або чотири хвилини), як запитує Last.fm."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài hát được tính khi bạn đã nghe được một nửa (hoặc bốn phút), như Last.fm yêu cầu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正如 Last.fm 所要求的，一旦您聽了一半（或四分鐘），歌曲就開始計數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正如 Last.fm 所要求的，一旦您听了一半（或四分钟），歌曲就开始计数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正如 Last.fm 所要求的，一旦您聽了一半（或四分鐘），歌曲就開始計數。"
          }
        }
      }
    },
