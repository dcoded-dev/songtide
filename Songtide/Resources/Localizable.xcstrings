          "stringUnit": {
            "state": "translated",
            "value": "Пісня відтворюється в Songtide як «Назва — Виконавець»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài hát đang phát trong Songtide, có tên \"Title — Artist\"."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Songtide中播放的歌曲，為「Title — Artist」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Songtide中播放的歌曲，为“Title — Artist”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Songtide中播放的歌曲，為「Title — Artist」。"
          }
        }
      }
    },
    "The visualizer can't hear the music yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع المتخيل سماع الموسيقى بعد"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El visualitzador encara no pot escoltar la música"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizualizér zatím neslyší hudbu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizeren kan ikke høre musikken endnu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Visualizer kann die Musik noch nicht hören"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο οπτικοποιητής δεν μπορεί να ακούσει ακόμα τη μουσική"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El visualizador aún no puede escuchar la música."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El visualizador aún no puede escuchar la música."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisoija ei vielä kuule musiikkia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visualiseur n'entend pas encore la musique"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visualiseur n'entend pas encore la musique"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוויזואליזר לא יכול לשמוע את המוזיקה עדיין"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज़ुअलाइज़र अभी तक संगीत नहीं सुन सकता है"
          }
        },
        "hr": {
